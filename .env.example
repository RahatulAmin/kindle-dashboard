# Local and Compose listener address. Use a specific trusted LAN
# interface IP for phone/Kindle access. Keep the default for local use.
APP_HOST=127.0.0.1
APP_PORT=8765
# Host bind mount sources. Compose assigns separate paths inside the container.
PERSISTENT_DATA_DIR=/srv/kindle-dashboard/data
DATABASE_PATH=/srv/kindle-dashboard/data/db/dashboard.sqlite3
LOG_DIR=/srv/kindle-dashboard/logs
LOG_LEVEL=INFO
# stdout works with bounded Docker logging. Use file for rotating local JSONL.
LOG_DESTINATION=stdout
APP_UID=1000
APP_GID=1000
APP_TIMEZONE=America/Toronto
TEMPERATURE_UNIT=C
APP_LANGUAGE=en
KINDLE_WIDTH=758
KINDLE_HEIGHT=1024
# Reserved for future display modes. Phase 1 refreshes on manual reload.
DASHBOARD_REFRESH_SECONDS=60
POMODORO_REFRESH_SECONDS=30
PHOTO_ROTATION_SECONDS=600
IDLE_TIMEOUT_SECONDS=300
# Reserved policy for future login and device enrollment. Leave secrets unset.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
DEVICE_TOKEN_TTL_SECONDS=2592000
